# =======================================================
# APPLICATION CONFIGURATION (.env) - nestjs_backend
# =======================================================

# 1. SERVER CONFIGURATION
PORT=8080
NODE_ENV=development

# 2. MYSQL DATABASE CONFIGURATION (Database: vphxc)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
DB_TIMEZONE=+07:00

# 3. CONNECTION POOL CONFIGURATION
DB_POOL_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECTION_TIMEOUT=20000
DB_IDLE_TIMEOUT=300000
DB_ENABLE_MULTIPLE_STATEMENTS=true

# 4. CORS ALLOWED ORIGINS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# 5. JWT & SECURITY AUTHENTICATION CONFIGURATION
JWT_SECRET_KEY=your_jwt_secret_key_minimum_256_bits
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30
JWT_COOKIE_NAME=refreshToken
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=lax

